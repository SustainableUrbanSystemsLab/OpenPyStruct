# CUDA variant of the OpenPyStruct engine image, for GPU training.
#
#   docker build -t openpystruct:cuda -f docker/Dockerfile.cuda .
#   docker run --rm --gpus all -v "$PWD/work:/work" openpystruct:cuda run /work/case.json /work/result.json
#
# Set the image name to openpystruct:cuda and turn GPU on in the Engine component.
FROM docker.io/pytorch/pytorch:2.4.0-cuda12.1-cudnn9-runtime

ENV PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1 PIP_DISABLE_PIP_VERSION_CHECK=1

RUN pip install openseespy || echo "openseespy not installable on this platform; numpy backend will be used"

WORKDIR /src
COPY pyproject.toml README.md ./
COPY openpystruct ./openpystruct
RUN pip install .

WORKDIR /work
ENTRYPOINT ["openpystruct"]
CMD ["info"]
